{
  "$comment": "Bridge 模型单一真源。模型规格只写入 catalog；Headless、回滚 provider 与单 Bot 策略通过 modelSets 引用。改完后运行 bash scripts/headless-daemon.sh restart。密钥不写这里，走 env / apiKeyFromFile / cliproxy yaml。覆盖路径：HEADLESS_MODELS_CONFIG。",
  "schemaVersion": 2,
  "officialFallback": "cliproxy/deepseek-v4-flash",
  "defaults": {
    "maxContextWindowTokens": 200000,
    "codexWaitTimeoutMs": 3600000,
    "claudeWaitTimeoutMs": 3600000,
    "claudeDefaultModel": "gemini-flash",
    "claudeFallbackModel": "deepseek-v4-flash",
    "claudeDefaultEffort": "",
    "claudeModelSet": "claude-cli",
    "claudeModelPrefix": "",
    "claudeHaikuModel": "cursor-auto",
    "claudeSmallFastModel": "cursor-auto",
    "claudeBare": true,
    "claudeStrictMcp": true,
    "codexSlim": true
  },
  "display": {
    "officialModels": {
      "enabled": true,
      "allowIds": [],
      "blockIds": [
        "auto"
      ]
    },
    "nameDedup": "suffix-provider",
    "unknownBareId": "hide"
  },
  "paths": {
    "cliproxyConfig": "${HOME}/.cli-proxy-api/config.yaml",
    "agentsMd": "memory/AGENTS.md",
    "sessionState": "${HOME}/.copilot/session-state",
    "mcpConfig": "${HOME}/.copilot/mcp-config.json",
    "codexAgentsDir": "${HOME}/.agents/workspace",
    "codexSessionDir": "${HOME}/.codex/sessions",
    "codexStateDir": "/tmp/telegram-bridge/codex",
    "claudeWorkDir": "${HOME}/.agents/workspace",
    "claudeSessionDir": "${HOME}/.claude",
    "claudeStateDir": "/tmp/telegram-bridge/claude"
  },
  "launchAgentLabel": "com.copilot-telegram-bridge",
  "catalog": {
    "deepseek-v4-flash": {
      "label": "DeepSeek V4 Flash",
      "maxPromptTokens": 1000000,
      "maxContextWindowTokens": 1000000,
      "maxOutputTokens": 32000
    },
    "deepseek-v4-pro": {
      "label": "DeepSeek V4 Pro",
      "maxPromptTokens": 1000000,
      "maxContextWindowTokens": 1000000,
      "maxOutputTokens": 32000
    },
    "mimo-v2.5": {
      "label": "MiMo V2.5",
      "maxPromptTokens": 1000000,
      "maxContextWindowTokens": 1000000,
      "maxOutputTokens": 32000
    },
    "mimo-v2.5-pro": {
      "label": "MiMo V2.5 Pro",
      "maxPromptTokens": 1000000,
      "maxContextWindowTokens": 1000000,
      "maxOutputTokens": 32000
    },
    "gemini-flash": {
      "label": "Gemini Flash",
      "maxPromptTokens": 1000000,
      "maxContextWindowTokens": 1000000,
      "maxOutputTokens": 65536
    },
    "cursor-auto": {
      "label": "Cursor Auto",
      "maxPromptTokens": 256000,
      "maxContextWindowTokens": 256000,
      "maxOutputTokens": 32000
    },
    "cursor-grok-4.6-low": {
      "label": "Cursor Grok 4.6 Low",
      "maxPromptTokens": 256000,
      "maxContextWindowTokens": 256000,
      "maxOutputTokens": 32000
    },
    "cursor-grok-4.6-medium": {
      "label": "Cursor Grok 4.6 Medium",
      "maxPromptTokens": 256000,
      "maxContextWindowTokens": 256000,
      "maxOutputTokens": 32000
    },
    "cursor-grok-4.6-high": {
      "label": "Cursor Grok 4.6 High",
      "maxPromptTokens": 256000,
      "maxContextWindowTokens": 256000,
      "maxOutputTokens": 32000
    },
    "cursor-grok-4.6-xhigh": {
      "label": "Cursor Grok 4.6 XHigh",
      "maxPromptTokens": 256000,
      "maxContextWindowTokens": 256000,
      "maxOutputTokens": 32000
    },
    "kimi-k3-low": {
      "label": "Kimi K3 Low",
      "maxPromptTokens": 1000000,
      "maxContextWindowTokens": 1000000,
      "maxOutputTokens": 32000
    },
    "kimi-k3-high": {
      "label": "Kimi K3 High",
      "maxPromptTokens": 1000000,
      "maxContextWindowTokens": 1000000,
      "maxOutputTokens": 32000
    },
    "kimi-k3-max": {
      "label": "Kimi K3 Max",
      "maxPromptTokens": 1000000,
      "maxContextWindowTokens": 1000000,
      "maxOutputTokens": 32000
    },
    "cursor-grok-4.5-high": {
      "label": "Cursor Grok 4.5 High",
      "maxPromptTokens": 256000,
      "maxContextWindowTokens": 256000,
      "maxOutputTokens": 32000
    },
    "cursor-grok-4.5-medium": {
      "label": "Cursor Grok 4.5 Medium",
      "maxPromptTokens": 256000,
      "maxContextWindowTokens": 256000,
      "maxOutputTokens": 32000
    },
    "cursor-grok-4.5-low": {
      "label": "Cursor Grok 4.5 Low",
      "maxPromptTokens": 256000,
      "maxContextWindowTokens": 256000,
      "maxOutputTokens": 32000
    },
    "composer-2.5": {
      "label": "Composer 2.5",
      "maxPromptTokens": 200000,
      "maxContextWindowTokens": 200000,
      "maxOutputTokens": 32000
    }
  },
  "modelSets": {
    "claude-cli": {
      "$comment": "/claude 模型菜单。增删只改这里；发给 CLI 的 slug 为 catalog id（直连 cliproxy，无 cliproxy/ 前缀）。",
      "defaultModel": "gemini-flash",
      "models": [
        "gemini-flash",
        "deepseek-v4-flash",
        "deepseek-v4-pro",
        "cursor-auto",
        "cursor-grok-4.6-high",
        "kimi-k3-high",
        "kimi-k3-max"
      ]
    },
    "headless": {
      "$comment": "Headless 主 Bot 的有序模型列表；顺序同时用于 /model 与默认选择。",
      "defaultModel": "deepseek-v4-flash",
      "models": [
        "deepseek-v4-flash",
        "deepseek-v4-pro",
        "gemini-flash",
        "cursor-auto",
        "cursor-grok-4.6-low",
        "cursor-grok-4.6-medium",
        "cursor-grok-4.6-high",
        "kimi-k3-low",
        "kimi-k3-high"
      ]
    },
    "rollback-opencode": {
      "models": [
        "deepseek-v4-flash",
        "deepseek-v4-pro",
        "mimo-v2.5",
        "mimo-v2.5-pro"
      ]
    },
    "rollback-deepseek": {
      "models": [
        "deepseek-v4-flash",
        "deepseek-v4-pro"
      ]
    }
  },
  "skillSets": {
    "$comment": "可选白名单，空则不过滤。bots.json 写 skillSet 名才套用本组。"
  },
  "providers": [
    {
      "$comment": "[回滚开关] OpenCodex 10100：把本组 enabled=true 并把 cliproxy 组 enabled=false。",
      "id": "opencodex",
      "enabled": false,
      "type": "openai",
      "baseUrl": "http://127.0.0.1:10100/v1",
      "baseUrlEnv": [
        "OPENCODEX_BASE_URL"
      ],
      "apiKeyEnv": [
        "OPENCODEX_API_KEY"
      ],
      "apiKeyFromFile": "${HOME}/.opencodex/admin-api-token",
      "modelSet": "headless"
    },
    {
      "$comment": "[回滚开关] OpenCode：把本组 enabled=true 并把 opencodex 组 enabled=false。",
      "id": "opencode",
      "enabled": false,
      "type": "openai",
      "baseUrl": "https://opencode.ai/zen/go/v1",
      "baseUrlEnv": [
        "OPENCODE_BASE_URL",
        "OPENCODE_GO_BASE_URL"
      ],
      "apiKeyEnv": [
        "OPENCODE_API_KEY",
        "OPENCODE_GO_API_KEY"
      ],
      "modelSet": "rollback-opencode"
    },
    {
      "$comment": "CLI Proxy 8317：当前默认第三方上游，直接承载 Headless 模型组。",
      "id": "cliproxy",
      "enabled": true,
      "type": "openai",
      "baseUrl": "http://127.0.0.1:8317/v1",
      "baseUrlEnv": [
        "CLIPROXY_BASE_URL",
        "CLI_PROXY_BASE_URL"
      ],
      "apiKeyEnv": [
        "CLIPROXY_API_KEY",
        "CLI_PROXY_API_KEY"
      ],
      "apiKeyFromCliproxyYaml": true,
      "portFromCliproxyYaml": true,
      "modelSet": "headless"
    },
    {
      "$comment": "官方直连 DeepSeek API：默认 enabled=false，仅作紧急回退。",
      "id": "deepseek",
      "enabled": false,
      "type": "openai",
      "baseUrl": "https://api.deepseek.com/v1",
      "baseUrlEnv": [
        "DEEPSEEK_BASE_URL"
      ],
      "apiKeyEnv": [
        "DEEPSEEK_API_KEY"
      ],
      "modelSet": "rollback-deepseek"
    }
  ]
}
